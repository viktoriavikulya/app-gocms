{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastygo.dev/schema/codex/v1/seed-site.schema.json",
  "title": "Codex SiteSeedBundle",
  "description": "codex.v1 JSON seed bundle for fixtures, imports, and prototype CMS content",
  "type": "object",
  "required": ["codex_version", "site", "content_types", "content_entries", "menus"],
  "additionalProperties": false,
  "properties": {
    "codex_version": {
      "type": "string",
      "const": "codex.v1"
    },
    "site": { "$ref": "#/$defs/site" },
    "content_types": {
      "type": "array",
      "items": { "$ref": "https://fastygo.dev/schema/codex/v1/content-type.schema.json" },
      "minItems": 1
    },
    "content_entries": {
      "type": "array",
      "items": { "$ref": "https://fastygo.dev/schema/codex/v1/content-entry.schema.json" }
    },
    "menus": {
      "type": "array",
      "items": { "$ref": "https://fastygo.dev/schema/codex/v1/menu.schema.json" }
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "locale": { "type": "string", "minLength": 2 }
      }
    },
    "setting": {
      "type": "object",
      "required": ["key", "group", "value"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "value": {},
        "public": { "type": "boolean" }
      }
    }
  }
}
